# Credenciais do Supabase (obrigatórias — mantidas exclusivamente no backend)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua-chave-service-role-aqui

# Níveis de acesso da plataforma Animora
# Common: público (sem chave) — consulta de etiquetas e ficha pública via QR Code
# Property: adição/atribuição de animais e gestão de vacinação
ANIMORA_PROPERTY_PIN=animora2026
# Admin: acesso total + criação de QR Codes e lotes de etiquetas
ANIMORA_ADMIN_PIN=animora-admin2026

# Configurações da aplicação Flask (opcionais)
FLASK_SECRET_KEY=troque-por-uma-chave-secreta-segura
APP_BASE_URL=http://localhost:5000
FLASK_DEBUG=True
PORT=5000
